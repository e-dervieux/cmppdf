set -u -e

RCSID='$Id: cmppdf,v 1.28 2026/11/22 00:59:22 jima Exp jima $'

##########################################################################
USAGE=$(cat <<'EOF'
 NAME
    cmppdf -- Compare the visual appearance or text of PDF files

 SYNOPSIS
    cmppdf [-q] FILE1 FILE2                        # compare appearance
    cmppdf [-q] --text FILE1 FILE2                 # compare text only
    cmppdf [-q] --text -o - FILE1 FILE2 >diffs.txt # capture diffs
    cmppdf [-q] -pw PASSWORD ... FILE1 FILE2       # handle passwords

 EXIT STATUS
   0  if no differences found
   1  if differences found
   2+ if trouble

 OPTIONS
   -t, --text      Compare the text in the PDFs, ignoring grapical appearance.

   --diff diff-option1,diff-option2, ...

     Implies --text.  
     Specify options to pass to the 'diff' command (default is '-u').

   -o, --outprefix PATHPREFIX

     With this option a "difference file" is created for each page which has 
     differences.  The files will named PREFIXpage_NNN.png (or with -t: .txt).
     If PREFIX has a trailing / the named directory will be created if needed.
     
     With visual comparison (the default), the files will be .png images with
     changed parts highlighted in RED.   With text comparison (--text option),
     the files will contain output from the 'diff' command, or if PATHPREFIX
     is '-' then all diffs are written to stdout.

   --pw common_password
   --pw1 password_for_FILE1
   --pw2 password_for_FILE2

     For when a pdf requires a password to open; if not given, prompts.

   -q, --quiet     Suppress progress messages

   -d, --debug     Show detailed information about commands run

 AUTHOR
   Jim Avera (jim.avera at gmail)
     Added command-line processing
     Added --text support
     Allow PDFs to have passwords (prompted interactively)
     Reworked temp files to allow curr-dir to be read-only
      and allow FILE1 and FILE2 to be the same.

   The graphical compare code was posted by 'linguisticturn' at
     https://stackoverflow.com/questions/6469157/pdf-compare-on-linux-command-line
     (License CC BY-SA 4.0)
     Whoever you are, please contact me so I can credit you properly!

 The latest version of this script can be downloaded
 from https://abhweb.org/jima/cmppdf?v

EOF
echo "$RCSID" | sed -n -e 's/.*,v \([0-9][0-9]*\.[.0-9]*\).*/ This is Version \1/p'
)

##########################################################################
# The basic idea:
# 1. Split each pdf into possibly-multiple single-page pdf files.
# 2. Convert each pdf into a .png image, or with --text, extract
#    the text for the page into a .txt file.
# 3. Compute and compare checksums of the corresponding file pairs.

# REQUIRES: pdftk pdftoppm pdftotxt b2sum compare(from imagemagick-6)

progname=$(basename "$0")

resolution=150
debug=
quiet=
diff_basepath=
textonly=
diff_opts=
tmpdir=
pw1=PROMPT
pw2=PROMPT
declare -a diff_opts=()

TEMP=$(getopt -o 'ho:r:tqd' \
        --long 'help,resolution:,textonly,diff-opts:,debug,tmpdir:,output:,pw:,pw1:,pw2:,quiet' \
        -n "$progname" -- ${1+"$@"})
[ $? -eq 0 ] || { echo "$progname -h for help" >&2; exit 2; }

# Hack to try to work on MacOS which has BSD getopt
case "$TEMP" in
  *--\ ho:r:tqd*)
    # We have BSD getopt, not GNU getopt. It processed the "-o"
    # as the 'optstring' and the rest as the input arguments.
    # In this case we directly parse the original args, after inserting
    # a "--" terminator after the last arg.  The user may not abbreviate
    # or use the --opt=value form.
    #prargs "ORIG:" ${1+"$@"}
    declare -a newopts=();
    while [ $# -gt 0 ] ; do
      case "$1" in
        -o*|-r*|--diff-opts|--tmpdir) newopts+=("$1" "$2") ; shift; shift ;;
        -*) newopts+=("$1"); shift ;;
        *) break ;;
      esac
    done
    newopts+=("--" ${1+"$@"})
    set -- "${newopts[@]}"
    #prargs "FINAL:" ${1+"$@"}
    ;;
  *)
    eval set -- "$TEMP" ; unset TEMP
    ;;
esac

while true ; do
  case "$1" in
    --)                                  shift; break ;;
    -o|--outprefix)  diff_basepath="$2"; shift; shift ;;
    -r|--resolution) resolution="$2";    shift; shift ;;
    -t|--textonly)   textonly=yes;              shift ;;
    --diff-opts)     IFS=',' command eval 'diff_opts+=($2)'; textonly=yes; shift; shift ;;
    --pw)            pw1="$2"; pw2="$2"; shift; shift ;;
    --pw1)           pw1="$2";           shift; shift ;;
    --pw2)           pw2="$2";           shift; shift ;;
    -q|--quiet)      quiet=yes;                 shift ;;
    -d|--debug)      debug=yes;                 shift ;;
    --tmpdir)        tmpdir="$2";        shift; shift ;;
    -h|--help)       [ -t 1 ] || PAGER=cat; echo "$USAGE" | ${PAGER:-more} ; exit 0 ;;
     *) echo "Internal error! (Unrecognized: $1)" >&2; exit 99 ;;
  esac
done

#[ -z "$debug" ] || quiet=
if [ -n "$debug" ] ; then setdashx="set -x;" ; else setdashx=""; fi
if [ ${#diff_opts[*]} -eq 0 ] ; then
  diff_opts=(-u)
fi

if [ $# -ne 2 ] ; then
  echo "$progname: Expecting two pdf file arguments" >&2
  echo "$progname -h for help" >&2
  exit 2
fi
file_1="$1"
file_2="$2"

shortcut_ok= 
[ -n "$quiet" ] && [ -n "$textonly" ] && [ -z "$diff_basepath" ] && shortcut_ok=yes

# Create a unique directory for temp files
if [ -z "$tmpdir" ] ; then
  tmpdir=$(mktemp --tmpdir --directory "$progname-XXXXXX")

  # trap any kind of exit and clean up first
  trap 'stat=$?; '"$setdashx"' rm -rf "$tmpdir"; exit $stat' 0 1 2 3 15
fi

# Get fully-qualified paths so we can change the current directory
path_1=$(realpath "$file_1")
path_2=$(realpath "$file_2")
if [ "$diff_basepath" = "-" ] ; then
  if [ -z "$textonly" ] ; then
    echo "--outpath '-' may only be used with --text" >&2;
    exit 2
  fi
elif [ -n "$diff_basepath" ] ; then
  case "$diff_basepath" in
    */) [ -d "$diff_basepath" ] || mkdir -v "$diff_basepath" ;;
    *)  [ ! -d "$diff_basepath" ] || diff_basepath="${diff_basepath}/" ;;
  esac
  # Remove any pre-existing output files
  for f in "${diff_basepath}"page_[0-9][0-9]*.{txt,png} ; do
    if [ -e "$f" ] ; then
      [ -n "$quiet" ] || echo "Removing pre-existing output '$f'" >&2
      rm "$f" || { echo "Could not remove existing $f" >&2; exit 2; }
    fi
  done
fi

# run_pdftk INFILE PW pdftkargs...
#
# First try without input_pw and if that fails then with it.  This is
# necessary because input_pw A=PROMPT is specified then pdftk always prompts
# even if the file is not encrypted.
# INFILE will use "filehandle" 'A'.  stderr is always sent to /dev/null
function run_pdftk {
  local inpath="$1" ; shift
  local pw="$1" ; shift
  [ -r "$inpath" ] || { echo "$inpath : UNREADABLE" >&2; exit 2; }
  ( eval $setdashx ;
    pdftk A="$inpath" "$@" dont_ask 2>/dev/null \
      || pdftk A="$inpath" input_pw "A=$pw" "$@" dont_ask 2>/dev/null
  )
}


# Change the current directory to $tmpdir and run commands from there.
# This avoids trouble if the user's current directory is not writable.
# Also pdftk always creates a "doc_data.txt" in the current dir and so
# this is the only way to avoid trying to write into the user's directory.
[ -z "$debug" ] || echo "cd $tmpdir" >&2
cd "$tmpdir" || { echo "PROBLEM WITH TDIR '${tmpdir}'" >&2; exit 2; }

if [ -n "$shortcut_ok" ] ; then
  # Don't burst; compare text of whole files
  run_pdftk "$path_1" "$pw1" output f1.pdf
  run_pdftk "$path_2" "$pw2" output f2.pdf
  (eval $setdashx; pdftotext f1.pdf f1.txt)
  (eval $setdashx; pdftotext f2.pdf - | cmp --quiet f1.txt -)
  exit $?
fi


# Burst the files into individual pages
run_pdftk "$path_1" "$pw1" burst output f1-page_%03d.pdf
run_pdftk "$path_2" "$pw2" burst output f2-page_%03d.pdf

status=0

# we loop over the individual pages of the first file
for f1 in `echo f1-page_*.pdf`
do
  # Set $page to e.g. 'page_003'
  page="${f1/f1-/}"
  page="${page/.pdf/}"

  # f2 is the name of the PDF of the corresponding page of the second file
  f2="${f1/f1/f2}"

  if [ ! -r "$f2" ] ; then
    status=1
    if [ -n "$shortcut_ok" ] ; then exit $status ; fi
    echo "$page is NOT PRESENT in the second file ($file_2)" >& 2;
    continue
  fi

  if [ -n "$textonly" ] ; then
    # Extract the text from individual page PDFs
    (eval $setdashx;
     pdftotext $f1 ${f1/.*}.txt  # e.g. page_001.txt
     pdftotext $f2 ${f2/.*}.txt
    )
    # 'g1' and 'g2' are the names of the two files we just created
    g1=${f1/.*}.txt
    g2=${f2/.*}.txt
  else
    # Convert the individual page PDFs to PNGs
    (eval $setdashx;
     pdftoppm "$f1" f1 -png -r $resolution
     pdftoppm "$f2" f2 -png -r $resolution
    )
    # 'g1' and 'g2' are the names of the two PNG files we just created.
    # The "-1" is the page number appended by pdftoppm.
    g1=f1-1.png
    g2=f2-1.png
  fi

  # Create the checksums for the two files
  B2S_1=$((eval $setdashx; b2sum "$g1") | awk '{print $1}')
  B2S_2=$((eval $setdashx; b2sum "$g2") | awk '{print $1}')

  # Now we compare the checksums
  if [ "$B2S_1" = "$B2S_2" ]; then
    [ -n "$quiet" ] || echo "$page: same" >&2;
  else
    status=1
    if [ -n "$shortcut_ok" ] ; then exit $status ; fi
    # The checksums are different.
    # Create a difference file for each page (if requested)
    if [ -n "$diff_basepath" ] ; then
      if [ "$diff_basepath" = "-" ] ; then
        # only with --text
        (eval $setdashx; diff "${diff_opts[@]}" "$g1" "$g2") || true
      else
        if [ -n "$textonly" ] ; then
          outfile="${diff_basepath}${page}.txt"
          (eval $setdashx; diff "${diff_opts[@]}" "$g1" "$g2" > "$outfile") || true
        else
          outfile="${diff_basepath}${page}.png"
          (eval $setdashx; compare "$g1" "$g2" "$outfile") || true
        fi
        if [ -r "$outfile" ] ; then
          [ -n "$quiet" ] || echo "Created '$outfile'" >&2
        else
          echo "Error creating '$outfile'" >&2 # e.g. non-writable directory?
          exit 2
        fi
      fi
    else
      [ -n "$quiet" ] || echo "$page: different" >&2;
    fi
  fi
done

# Check that $file_2 does not have extra pages
for f2 in `echo f2-page_*.pdf`
do
  page="${f2/f2-/}"
  page="${page/.pdf/}"

  f1="${f2/f2/f1}"
  if [ ! -r "$f1" ] ; then
    [ -z "$quiet" ] && echo "$page is NOT PRESENT in the first file ($file_1)" >& 2;
    status=1
    #exit $status
    continue
  fi
done

exit $status
